# Rust build output; Cargo.lock remains version controlled for this workspace.
/target/

# Generated device reports can contain machine-specific hardware information.
*.probe.json
# Local secrets; keep sanitized examples eligible for version control.
.env
.env.*
!.env.example
!.env.*.example

# Local contracts/evidence are still used; ignore is not deletion or obsolescence.
/_bmad-output/

